[package]
name = "{{ ctx.package_name }}"
version = "0.1.0"
edition = "2021"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]

# `wasm-bindgen` must be exactly the version the `skyzen` CLI embeds its bindings generator from.
# The two share a schema version and wasm-bindgen refuses to pair a module with a generator that
# does not match, so leaving this floating makes the first Cloudflare build fail with an opaque
# error. `skyzen doctor` re-checks it, and `cargo update -p wasm-bindgen --precise <version>`
# restores agreement after upgrading the CLI.
[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = "={{ ctx.wasm_bindgen_version }}"

[package.metadata.cargo-machete]
# `utoipa` is reached only through what `#[derive(ToSchema)]` EXPANDS to — `::utoipa::…` paths —
# so no source line names the crate and an unused-dependency check cannot see the use. Removing it
# breaks the derive.
ignored = ["utoipa"]
