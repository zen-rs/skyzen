use skyzen::routing::{CreateRouteNode, Route, Router};

async fn root() -> &'static str {
    "Hello from {{ ctx.package_name }} durable worker!"
}

async fn health() -> &'static str {
    "OK"
}

pub fn router() -> Router {
    Route::new((
        "/".at(root),
        "/health".at(health),
    ))
    .build()
}

