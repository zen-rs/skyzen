use std::sync::atomic::{AtomicU64, Ordering};

use serde::{Deserialize, Serialize};
use skyzen::durable::{DurableObject, WebSocketEvent};
use skyzen::routing::{CreateRouteNode, Route, Router};

/// One room. The struct lives as long as the platform keeps the instance, and every event on the
/// instance shares it, so a count kept here is behind an atomic rather than a plain field.
#[derive(Default, Serialize, Deserialize)]
#[skyzen::durable_object]
pub struct Room {
    messages_seen: AtomicU64,
}

impl DurableObject for Room {
    fn fetch(&self) -> Router {
        Route::new((
            "/".at(|| async { "room ready" }),
        ))
        .build()
    }

    async fn websocket(
        &self,
        socket: &skyzen::durable::WebSocketConnection,
        event: WebSocketEvent,
        ctx: &skyzen::durable::DurableContext,
    ) -> Result<(), skyzen::durable::DurableObjectError> {
        if let WebSocketEvent::Message(message) = event {
            self.messages_seen.fetch_add(1, Ordering::Relaxed);
            if let Some(text) = message.into_text() {
                socket.send_text(&format!("echo from room {}: {text}", ctx.id()))?;
            }
        }
        Ok(())
    }
}
