import { createBindings } from "./{{ bindings_name }}";
import wasmUrl from "./{{ wasm_name }}";

// One application per isolate, shared by every invocation — the same cost as
// the pre-0.4.3 shim. It is replaced only when poisoned, and never reset:
// invocations still in flight on the old one keep their references and finish
// or fail on their own, so `__wbg_reset_state` is never called.
function application() {
  let failed = false;
  const onError = error => {
    if (error instanceof WebAssembly.RuntimeError) failed = true;
  };
  const exports = createBindings(wasmUrl, onError);
  if (exports.setPanicHook) {
    exports.setPanicHook(message => {
      failed = true;
      console.error("Rust panic: " + message);
    });
  }
  return {
    exports,
    onError,
    get failed() {
      return failed;
    },
    get depth() {
      return exports.depth ?? 0;
    },
    get stranded() {
      return exports.stranded ?? 0;
    },
  };
}

let current = null;

// Returns the isolate's application, switching generations when the current
// one is poisoned. A non-zero `depth` at an event boundary means a wasm call
// never ran its `finally`: the runtime terminated it (an uncatchable CPU kill
// skips the decrement). A non-zero `stranded` means a microtask the executor
// posted never ran — it was dropped or killed while pending, and the
// executor's scheduling flag stays set forever, starving every future on the
// instance. A WebAssembly.RuntimeError through `onError` or a Rust panic
// through the panic hook marks it `failed`; a thrown or rejected handler error
// is routed through `onError` too, so only a real wasm trap poisons — an
// ordinary Error keeps the shared application. In every poisoned case a fresh
// application serves this and every later invocation; the shim drops its
// reference to the old one, which in-flight invocations already captured.
function entry() {
  if (current === null || current.depth !== 0 || current.stranded !== 0 || current.failed) {
    current = application();
  }
  return current;
}

export default {
  async fetch(request, env, ctx) {
    const app = entry();
    try {
      return await app.exports.fetch(request, env, ctx);
    } catch (error) {
      app.onError(error);
      throw error;
    }
  },
{%- for member in event_members %}
  async {{ member.name }}({{ member.args }}) {
    const app = entry();
    if (typeof app.exports.{{ member.name }} !== "function") {
      throw new Error("Skyzen.toml declares a {{ member.name }} handler but the wasm module does not export one; annotate a Rust handler with {{ member.macro_hint }}");
    }
    try {
      return await app.exports.{{ member.name }}({{ member.args }});
    } catch (error) {
      app.onError(error);
      throw error;
    }
  },
{%- endfor %}
};
{% if !durable_exports.is_empty() %}
// A Durable Object owns persistent in-memory state, so its application belongs
// to the object, not an individual method call. Other objects and Worker events
// never share its bindings — the shared `current` is for the Worker's
// invocations only. The same poison check applies on every method entry, so a
// killed or trapped method replaces only this object's application.
function durableClass(name) {
  return class {
    constructor(...args) {
      let app;
      let instance;
      function current() {
        if (!app || app.failed || app.depth !== 0 || app.stranded !== 0) {
          app = application();
          instance = new app.exports[name](...args);
        }
        return instance;
      }
      current();
      return new Proxy(this, {
        get(_target, prop) {
          const value = Reflect.get(current(), prop, instance);
          if (typeof value !== 'function') return value;
          return (...methodArgs) => {
            const receiver = current();
            const owner = app;
            try {
              const result = Reflect.apply(Reflect.get(receiver, prop), receiver, methodArgs);
              // wasm-bindgen's async exports are ordinary JS functions returning
              // Promises. Checking Function vs AsyncFunction misses rejections.
              if (result && typeof result.then === 'function') {
                return result.catch(error => { owner.onError(error); throw error; });
              }
              return result;
            } catch (error) {
              owner.onError(error);
              throw error;
            }
          };
        },
        set(_target, prop, value) { return Reflect.set(current(), prop, value); },
        has(_target, prop) { return Reflect.has(current(), prop); },
      });
    }
  };
}
{%- for export in durable_exports %}
const {{ export.public_name }} = durableClass("{{ export.bindings_export_name }}");
export { {{ export.public_name }} };
{%- endfor %}
{%- endif %}
